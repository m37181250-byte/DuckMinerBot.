[app]
title = Duck AI Miner
package.name = duckminer
package.domain = org.test
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 0.1

# کتابخانه‌های مورد نیاز برای تریدر و گرافیک
requirements = python3,kivy,requests,ccxt,certifi

orientation = portrait
fullscreen = 0

# حل مشکل کلیک و دسترسی که در تصویر ۱۰ داشتی
android.permissions = INTERNET, SYSTEM_ALERT_WINDOW, FOREGROUND_SERVICE
android.api = 33
android.minapi = 21
android.sdk = 33
android.archs = arm64-v8a, armeabi-v7a

# فعال‌سازی سرویس برای اجرای در پس‌زمینه
android.services = monitor:main.py

[buildozer]
log_level = 2
warn_on_root = 1
